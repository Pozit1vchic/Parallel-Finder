/tests/artifacts/
coverage/
*.gcda
*.gcno
*.profraw
/artifacts/
.env
.env.*
!.env.example

# Python tooling
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# OS noise
Thumbs.db
desktop.ini
.DS_Store
$RECYCLE.BIN/
