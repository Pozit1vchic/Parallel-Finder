# Build output
/build/
/out/
/dist/
/release/
/release-models/
/cmake-build-*/
**/CMakeFiles/
**/CMakeCache.txt
**/cmake_install.cmake
**/CTestTestfile.cmake
**/build.ninja
**/.ninja_deps
**/.ninja_log
**/Makefile
*_autogen/
.qt/

# Compiled artifacts and generated bundles
*.exe
*.dll
*.pdb
*.ilk
*.obj
*.o
*.a
*.lib
*.exp
*.so
*.dylib
*.dSYM/
*.user
*.user.*

# Model weights and exported runtime assets.
# The checked-in models/*.json metadata remains tracked.
models/*.onnx
models/*.pt
models/*.engine
models/*.trt
models/*.plan
models/*.safetensors
models/*.part
*.onnx.part
# Downloaded weights and TensorRT caches must not leak from other folders.
*.onnx
*.pt
*.engine
*.trt
*.plan
*.safetensors
*.pfc
# Small, intentionally versioned test fixtures may be kept here.
!tests/fixtures/**/*.onnx

# Developer-only model/source bundles
/PF_CUDA/
/YOLO_Download_Project/
/models-cache/
/providers/dml/
/providers/cuda/
/providers/tensorrt/
/providers/*.staging/
/providers/*.previous/
/providers/active.txt

# Runtime state, caches, previews and logs
/cache/
/previews/
/logs/
/tmp/
/temp/
*.log
*.log.*
*.dmp
/settings.json
settings.local.json
*.part
*.tmp
*.bak
*.backup
*.zip
*.7z
!tests/fixtures/**/*.zip
!tests/fixtures/**/*.7z
*.stackdump
.parallel-finder/

# IDE / compiler tooling
.vs/
.vscode/
.idea/
compile_commands.json
.clangd/
.cache/
.coverage/

