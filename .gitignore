# Model weights and exported runtime assets.
# The checked-in models/*.json metadata remains tracked.
models/*.onnx
models/*.pt
models/*.engine
models/*.trt
models/*.plan
models/*.safetensors
models/*.part
*.onnx.part
# Downloaded weights and TensorRT caches must not leak from other folders.
*.onnx
*.pt
*.engine
*.trt
*.plan
*.safetensors
*.pfc
TensorrtExecutionProvider*.profile
TensorrtExecutionProvider*.timing
